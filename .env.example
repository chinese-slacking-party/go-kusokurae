# go-kusokurae server configuration
#
# Copy this file to .env and edit. Real environment variables always take
# precedence over values in this file. Missing keys fall back to the built-in
# defaults shown here; invalid or contradictory values abort startup.

# Default turn timeout in seconds. Per-room requests that send
# turn_timeout_seconds=0 use this value.
KUSOKURAE_TURN_TIMEOUT_SECONDS=30

# Default TURN_TIME_SYNC interval in seconds. Must be strictly less than
# KUSOKURAE_TURN_TIMEOUT_SECONDS.
KUSOKURAE_TURN_SYNC_INTERVAL_SECONDS=5

# API validation bounds for turn_timeout_seconds:
# 1 <= MIN < KUSOKURAE_TURN_TIMEOUT_SECONDS <= MAX
KUSOKURAE_MIN_TURN_TIMEOUT_SECONDS=5
KUSOKURAE_MAX_TURN_TIMEOUT_SECONDS=120

# API validation bounds for turn_sync_interval_seconds:
# 1 <= MIN < KUSOKURAE_TURN_SYNC_INTERVAL_SECONDS <= MAX
KUSOKURAE_MIN_TURN_SYNC_INTERVAL_SECONDS=1
KUSOKURAE_MAX_TURN_SYNC_INTERVAL_SECONDS=60

# HTTP listen port.
KUSOKURAE_PORT=8080

# Optional: path to the .env file itself. Only read from the real environment
# (it cannot be set inside this file). When unset, ".env" in the working
# directory is used, and a missing file is fine.
# KUSOKURAE_ENV_FILE=/etc/go-kusokurae/server.env
